# Salin menjadi backend/.env lalu sesuaikan.
# Untuk PostgreSQL lokal, jalankan sekali:  backend\.venv\Scripts\python.exe backend\scripts\init_postgres.py
# (skrip itu membuat role & database `hbac` lalu menulis DATABASE_URL di bawah secara otomatis)

# --- Database (PostgreSQL; kosong = SQLite di backend/data/hbac.db) ---
DATABASE_URL=postgresql+psycopg://hbac:GANTI_PASSWORD@127.0.0.1:5432/hbac
# Database khusus pengujian (pytest akan menghapus & membuat ulang tabelnya!)
TEST_DATABASE_URL=postgresql+psycopg://hbac:GANTI_PASSWORD@127.0.0.1:5432/hbac_test

# --- Keamanan ---
JWT_SECRET=ganti-dengan-string-acak-minimal-32-karakter
COOKIE_SECURE=false
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000
DEVICE_API_KEY=ganti-kunci-reader

# --- Mode demo (tombol login satu klik + data fiktif) ---
DEMO_MODE=true
SEED_ON_STARTUP=true
ALLOW_SELF_REGISTRATION=true

# --- Gemini API (chatbot). Kosong = mode lokal (kutipan dokumen + balasan percakapan dasar) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite

# --- WhatsApp API. Kosong = mode SIMULASI. Bisa juga diisi lewat Admin -> Pengaturan WhatsApp ---
# Pilih salah satu: META_CLOUD (WhatsApp Business Cloud API) atau GENERIC_HTTP (Fonnte/Wablas/Qontak, dsb.)
WHATSAPP_PROVIDER=
# Meta Cloud API
WHATSAPP_API_VERSION=v23.0
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=id
# Gateway HTTP generik
WHATSAPP_GATEWAY_URL=
WHATSAPP_GATEWAY_TOKEN=
WHATSAPP_GATEWAY_AUTH_HEADER=Authorization
WHATSAPP_GATEWAY_PHONE_FIELD=target
WHATSAPP_GATEWAY_MESSAGE_FIELD=message
WHATSAPP_GATEWAY_FORMAT=json

# Nomor petugas K3 on-duty untuk flag "review segera"
K3_ONDUTY_PHONE=+6281100000000
