# Contoh isi .env.prod di VPS. Biasanya TIDAK perlu dibuat manual: deploy/install.sh membuatnya otomatis
# (rahasia acak + pertanyaan domain, API key Gemini, mode demo). Rahasia manual: openssl rand -hex 24
POSTGRES_PASSWORD=
JWT_SECRET=
DEVICE_API_KEY=
# Password akun contoh hasil seed (admin, budi, siti, ...). Kosong = "Hbac-Demo-2026" (JANGAN untuk server publik).
DEMO_PASSWORD=

# Pakai domain + HTTPS (ubah dengan: bash deploy/set-domain.sh hbac.contoh.id):
#   SITE_ADDRESS=hbac.contoh.id   PUBLIC_URL=https://hbac.contoh.id   COOKIE_SECURE=true
# Hanya IP (HTTP):
#   SITE_ADDRESS=:80              PUBLIC_URL=http://IP_VPS            COOKIE_SECURE=false
SITE_ADDRESS=:80
PUBLIC_URL=http://IP_VPS
COOKIE_SECURE=false

# Mode demo = tombol login satu klik ke akun contoh berdata fiktif (kunci situs dengan password bila aktif).
DEMO_MODE=false
ALLOW_SELF_REGISTRATION=false
GEMINI_API_KEY=
